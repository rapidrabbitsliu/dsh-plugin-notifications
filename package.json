{
  "name": "dsh-plugin-notifications",
  "version": "1.2.0",
  "description": "Cross-device Web Push notifications for DSH task status and user confirmations",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "core.js",
    "client.js",
    "sw.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test *.test.js",
    "check": "node --check index.js && node --check core.js && node --check client.js && node --check sw.js"
  },
  "dependencies": {
    "socks-proxy-agent": "^10.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/rapidrabbitsliu/dsh-plugin-notifications.git",
    "type": "git"
  },
  "homepage": "https://github.com/rapidrabbitsliu/dsh-plugin-notifications#readme",
  "bugs": {
    "url": "https://github.com/rapidrabbitsliu/dsh-plugin-notifications/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "web-push",
    "notifications",
    "cordis"
  ]
}
